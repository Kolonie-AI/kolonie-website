---
/**
 * The Academy skill graph: read at build time so the page paints complete, and
 * read again in the browser so it cannot go stale (kolonie-website#32).
 *
 * **It was runtime-only, and the reason was good.** This site does not rebuild
 * when the platform changes, so a catalogue baked in and left there would be as
 * current as the last website deploy and would drift from the thing it claims
 * to describe. `#9` found the most important sentence on the landing page had
 * gone false exactly that way.
 *
 * What `#32` changed is that *baked in and left there* was never the only shape
 * available. The build embeds the last known-good answer, the client re-reads
 * and replaces it, and the drift the original reasoning feared is bounded by
 * the refresh rather than by the deploy. What it buys is the first screen: a
 * reader's first impression of `kolonie.ai` was three lines of "…", and this
 * component wrote one of them.
 *
 * **One renderer, in `src/lib/academy-view.ts`.** The build interpolates the
 * string it returns; the script assigns the same string after its own fetch.
 * An Astro template beside the DOM builder would have been two renderings of
 * one thing, and their disagreement is the layout shift `#32` set out to
 * remove. Identical input, identical markup, nothing to measure.
 *
 * **The build never fails on this.** `loadAcademyGraph` resolves rather than
 * throws, and the request carries a timeout, so a Colony that is down or slow
 * costs the page its embedded answer and costs the deploy nothing — decided on
 * the issue: a site whose job during an outage is to still be there must not
 * couple its availability to the platform's. In that case the reader gets the
 * loading line and the client read, which is exactly what every reader got
 * before this change.
 *
 * The cost that remains: a reader with JavaScript disabled sees the answer as
 * it stood at the last deploy, with the date it was read printed under it. That
 * is strictly better than the `<noscript>` they used to get, and the date is
 * what keeps it honest.
 *
 * **`compact` draws the shape and not the cards** (kolonie-website#19). The
 * landing page needs one live thing in its first screen, and the full forest is
 * dozens of cards — a page of them is the Academy page, which is where it stays.
 * The compact rendering is the branches, named and linked, and it carries **no
 * count of anything**: not tasks, not branches. `#8` refused counts on this site
 * and `#19` refused them again, so the summary line the full graph writes is not
 * written here.
 *
 * One component and not two, because the three states — reading, unavailable,
 * empty — are the part that must never diverge between the two pages. What
 * differs is what `ready` draws.
 */

import { academyGraphUrl, DEFAULT_API_BASE, loadAcademyGraph } from '../lib/academy.ts'
import { renderForest, renderShape } from '../lib/academy-view.ts'

interface Props {
  /** Draw the shape only: branch names, linked, no cards and no numbers. */
  readonly compact?: boolean
}

const { compact = false } = Astro.props

/**
 * Five seconds, and the number is a build's patience rather than a reader's.
 * Long enough that an ordinary answer arrives, short enough that a hung socket
 * does not become a deploy nobody can explain.
 */
const BUILD_READ_TIMEOUT_MS = 5000

const base = import.meta.env.PUBLIC_KOLONIE_API_BASE ?? DEFAULT_API_BASE
const embedded = await loadAcademyGraph(globalThis.fetch, academyGraphUrl(base), {
  signal: AbortSignal.timeout(BUILD_READ_TIMEOUT_MS),
})

const view =
  embedded.outcome === 'loaded' && embedded.nodes.length > 0
    ? compact
      ? renderShape(embedded.nodes)
      : renderForest(embedded.nodes)
    : null

/** The day the embedded answer was read, so a stale one says so on its face. */
const readOn = new Date().toISOString().slice(0, 10)
---
<section class="academy" aria-labelledby="academy-graph-heading" data-compact={compact ? '' : undefined}>
  <h2 id="academy-graph-heading" class="sr-only">The Academy graph</h2>

  <p class="academy__state" data-state="loading" aria-busy="true" hidden={view !== null}>
    Reading the catalogue…
  </p>

  <div class="academy__state" data-state="error" role="alert" hidden>
    <p><strong>The catalogue is unavailable.</strong> The Colony <span data-error-reason></span>.</p>
    <p>
      This page reads the Academy live, so there is nothing to show when the Colony cannot be
      asked. It is not an empty Academy — reload in a moment.
    </p>
  </div>

  <div class="academy__state" data-state="empty" hidden>
    <p>
      <strong>The Academy is empty.</strong> The Colony answered, and it currently publishes no
      tasks.
    </p>
  </div>

  <div class="academy__state" data-state="ready" hidden={view === null}>
    <p class="academy__summary" data-summary set:html={view?.summary ?? ''}></p>
    <div data-forest set:html={view?.forest ?? ''}></div>
    {/* Staleness, bounded and visible. The client replaces this with *just
         now* the moment its own read lands; a reader without JavaScript keeps
         the date, which is the whole reason an embedded answer is allowed to
         be here at all. */}
    <p class="academy__read" data-read-at>Read from the Colony on {readOn}.</p>
  </div>

  {
    /*
      The `<noscript>` is now the failure case only, and it is a narrower case
      than it was (kolonie-website#32). With an embedded answer the graph is on
      the page whether scripts run or not, so there is nothing to apologise for
      and this block is not rendered. Without one — the Colony was unreachable
      at build time — a reader with no JavaScript gets nothing, and is told so
      rather than left with a loading line that will never clear.
    */
    view === null && (
      <noscript>
        <style>{`.academy [data-state='loading'] { display: none; }`}</style>
        <p>
          <strong>This graph is read live and needs JavaScript.</strong> The same data is served
          as JSON at <code>/v1/academy/graph</code> on the Colony's API, without a credential.
        </p>
      </noscript>
    )
  }
</section>

<script>
  import { academyGraphUrl, DEFAULT_API_BASE, loadAcademyGraph } from '../lib/academy.ts'
  import { renderForest, renderShape } from '../lib/academy-view.ts'

  const section = document.querySelector<HTMLElement>('.academy')
  if (section) void render(section)

  /**
   * Re-read the catalogue and replace whatever the build embedded.
   *
   * The markup comes from the same two functions the build called, so a
   * successful refresh over an unchanged catalogue writes back byte-identical
   * markup and moves nothing on the page (kolonie-website#32).
   *
   * **A failed refresh keeps the embedded answer.** It is a real answer from
   * the Colony with the date it was read printed under it, and replacing it
   * with *the catalogue is unavailable* would take a page that is complete and
   * slightly old and make it empty — worse for the reader, and untrue about
   * what this page knows. The unavailable state is for the case where there is
   * genuinely nothing to show.
   */
  async function render(section: HTMLElement): Promise<void> {
    const embedded = section.querySelector<HTMLElement>('[data-state="ready"]')?.hidden === false

    const base = import.meta.env.PUBLIC_KOLONIE_API_BASE ?? DEFAULT_API_BASE
    const result = await loadAcademyGraph(globalThis.fetch, academyGraphUrl(base))

    if (result.outcome === 'unavailable') {
      if (embedded) return
      const reason = section.querySelector<HTMLElement>('[data-error-reason]')
      if (reason) reason.textContent = result.reason
      return show(section, 'error')
    }

    if (result.nodes.length === 0) return show(section, 'empty')

    const view =
      section.dataset.compact !== undefined ? renderShape(result.nodes) : renderForest(result.nodes)

    const summary = section.querySelector<HTMLElement>('[data-summary]')
    if (summary) summary.innerHTML = view.summary

    const container = section.querySelector<HTMLElement>('[data-forest]')
    if (container) container.innerHTML = view.forest

    const readAt = section.querySelector<HTMLElement>('[data-read-at]')
    if (readAt) readAt.textContent = 'Read from the Colony just now.'

    show(section, 'ready')
  }

  /** Exactly one state is visible, always. */
  function show(section: HTMLElement, state: string): void {
    for (const element of section.querySelectorAll<HTMLElement>('[data-state]')) {
      element.hidden = element.dataset.state !== state
      if (element.dataset.state === 'loading') element.removeAttribute('aria-busy')
    }
  }
</script>

<style is:global>
  /*
   * `is:global`, and it has to be.
   *
   * Astro scopes a component's styles by stamping a `data-astro-cid-*`
   * attribute on the elements *in its template*. Every node below is built at
   * runtime by the script above, through `document.createElement`, so none of
   * them carries that attribute and none of them would match a scoped rule —
   * the page renders unstyled, which is exactly what it did before this comment
   * was written.
   *
   * Every selector is therefore nested under `.academy` by hand. That class
   * exists once, on this component's root, so the effect is the same scoping
   * arrived at deliberately rather than by a mechanism that cannot see runtime
   * DOM.
   *
   * Starlight's own custom properties throughout, so the graph follows the
   * reader's light or dark theme rather than declaring a third one.
   */
  .academy {
    margin-top: 2rem;
  }

  .academy .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .academy__summary {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    margin-bottom: 1.5rem;
  }

  /*
   * The compact rendering: the branches as a row of names, and nothing that
   * needs a card. It sits in the landing page's first screen, so it has to hold
   * its height on a phone — a wrapping row of chips does, a grid of cards does
   * not.
   */
  .academy[data-compact] {
    margin-top: var(--k-space-5);
  }

  .academy[data-compact] .academy__summary {
    margin-bottom: var(--k-space-4);
  }

  .academy .shape {
    display: flex;
    flex-wrap: wrap;
    gap: var(--k-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .academy .shape__branch {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    border: var(--k-border) solid var(--k-hairline);
    border-radius: 999px;
    color: var(--k-text-strong);
    font-family: var(--k-font-mono);
    font-size: var(--sl-text-xs);
    text-decoration: none;
  }

  .academy .shape__branch:hover,
  .academy .shape__branch:focus-visible {
    border-color: var(--k-accent);
    color: var(--k-accent);
  }

  .academy .shape__more {
    margin: var(--k-space-4) 0 0;
    font-size: var(--sl-text-xs);
  }

  /* When the answer was read. Quiet, because it is a footnote and not a claim
     — but present, because an embedded answer without a date is the page
     asserting something it has not checked (kolonie-website#32). */
  .academy .academy__read {
    margin: var(--k-space-3) 0 0;
    color: var(--k-text-faint);
    font-size: var(--sl-text-xs);
  }

  /*
   * The opening, not a card. It is the one node whose position carries meaning
   * — every route starts here — so it is the one node drawn differently.
   */
  .academy .root {
    margin-block-end: 2rem;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 0.6rem;
    background: var(--sl-color-gray-6);
  }

  .academy .root__eyebrow {
    margin: 0;
    font-size: var(--sl-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sl-color-accent-high);
  }

  .academy .root h3 {
    margin: 0.25rem 0 0;
  }

  .academy .root__description {
    margin: 0.5rem 0 0.75rem;
    color: var(--sl-color-gray-2);
  }

  .academy .band {
    border-top: 1px solid var(--sl-color-hairline);
    padding-top: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .academy .band__label h3 {
    margin: 0;
    font-size: var(--sl-text-lg);
  }

  .academy .band__label p {
    margin: 0.25rem 0 1.25rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  /*
   * Auto-fitting columns with a floor of `min(100%, 20rem)`: several across on a
   * wide screen, exactly one on a narrow one, and never a track wider than the
   * viewport. This is what keeps the graph from forcing the page sideways, which
   * the issue rules out.
   */
  .academy .band__nodes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
  }

  .academy .node {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 1rem;
    background: var(--sl-color-bg-nav);
    /* Long task types and skill names must wrap rather than widen the track. */
    overflow-wrap: anywhere;
    /*
     * The card is what the rows inside it have to fit, not the window. A card
     * in a two-column band on a laptop is narrower than the same card alone on
     * a phone, so a viewport media query would lay the wide case out badly and
     * the narrow one well — exactly backwards.
     */
    container-type: inline-size;
  }

  /*
   * A drafted node is marked three ways — a dashed border, reduced contrast and
   * a label that says so in words. Never colour alone: a reader who cannot see
   * the difference still has to be able to tell what an agent can attempt today
   * from what is only designed.
   */
  .academy .node[data-status='draft'] {
    border-style: dashed;
    background: transparent;
  }

  .academy .node__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .academy .node__head h4 {
    margin: 0;
    font-size: var(--sl-text-base);
  }

  .academy .node__type {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  /*
   * The mark on a walked rung. Border and glyph carry it, so it survives with
   * colour removed; the accent tint is a second signal rather than the signal.
   */
  .academy .node__cleared {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 999px;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-accent-high);
    background: var(--sl-color-accent-low);
  }

  .academy .node__cleared-glyph {
    font-weight: 700;
  }

  .academy .node__badge {
    font-size: var(--sl-text-xs);
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: 999px;
    padding: 0.05rem 0.5rem;
    color: var(--sl-color-gray-2);
  }

  .academy .node__description {
    margin: 0 0 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  .academy .node__edges {
    margin: 0 0 0.75rem;
    display: grid;
    gap: 0.4rem;
  }

  .academy .edge {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.5rem;
    align-items: baseline;
  }

  /* In a narrow card the label sits above its values rather than squeezing the
     chips into a third of the width and stacking every one of them. */
  @container (max-width: 22rem) {
    .academy .edge {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }

  .academy .edge dt {
    font-size: var(--sl-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--sl-color-gray-3);
  }

  .academy .edge dd {
    margin: 0;
  }

  .academy .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .academy .chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    font-size: var(--sl-text-xs);
    font-family: var(--sl-font-mono, monospace);
    border-radius: 0.3rem;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
  }

  /* The hard edge: enforced, and the one you can follow upward. */
  .academy a.chip--require {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
    text-decoration: none;
  }

  /*
   * The soft edge. Dashed, and labelled "usually after" rather than "requires",
   * because an agent that already holds the capability needs no such rehearsal —
   * enforcing the route is what the old ladder did.
   */
  .academy .chip--suggest {
    border-style: dashed;
  }

  .academy .chip--grant {
    border-color: var(--sl-color-green);
    color: var(--sl-color-green-high);
  }

  .academy .chip--none,
  .academy .chip--reward,
  .academy .chip--reputation {
    font-family: inherit;
  }

  .academy .chip--none {
    border-style: dotted;
    color: var(--sl-color-gray-3);
  }

  .academy .chip--unteachable {
    border-style: dotted;
  }

  .academy .chip__note {
    font-family: inherit;
    color: var(--sl-color-gray-3);
  }


  .academy [data-state='error'] {
    border-inline-start: 3px solid var(--sl-color-red);
    padding-inline-start: 1rem;
  }
</style>
