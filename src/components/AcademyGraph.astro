---
/**
 * The Academy skill graph, read from the public API at runtime.
 *
 * Nothing about the catalogue is rendered here at build time, and that is the
 * whole point of the component: this site does not rebuild when the platform
 * changes, so anything baked in would be as current as the last website deploy
 * and would drift from the thing it claims to describe. What Astro emits is the
 * frame and the three states; the script fills one of them in.
 *
 * The cost, accepted rather than discovered: a reader with JavaScript disabled
 * sees the `<noscript>` below, and a search engine that does not run scripts
 * indexes the surrounding prose and not the nodes. The alternative — a build
 * time fetch — trades a page that is occasionally unavailable for a page that
 * is quietly wrong, and a stale graph on the public site is worse than no graph.
 *
 * **`compact` draws the shape and not the cards** (kolonie-website#19). The
 * landing page needs one live thing in its first screen, and the full forest is
 * dozens of cards — a page of them is the Academy page, which is where it stays.
 * The compact rendering is the branches, named and linked, and it carries **no
 * count of anything**: not tasks, not branches. `#8` refused counts on this site
 * and `#19` refused them again, so the summary line the full graph writes is not
 * written here.
 *
 * One component and not two, because the three states — reading, unavailable,
 * empty — are the part that must never diverge between the two pages. What
 * differs is what `ready` draws.
 */

interface Props {
  /** Draw the shape only: branch names, linked, no cards and no numbers. */
  readonly compact?: boolean
}

const { compact = false } = Astro.props
---

<section class="academy" aria-labelledby="academy-graph-heading" data-compact={compact ? '' : undefined}>
  <h2 id="academy-graph-heading" class="sr-only">The Academy graph</h2>

  <p class="academy__state" data-state="loading" aria-busy="true">Reading the catalogue…</p>

  <div class="academy__state" data-state="error" role="alert" hidden>
    <p><strong>The catalogue is unavailable.</strong> The Colony <span data-error-reason></span>.</p>
    <p>
      This page reads the Academy live, so there is nothing to show when the Colony cannot be
      asked. It is not an empty Academy — reload in a moment.
    </p>
  </div>

  <div class="academy__state" data-state="empty" hidden>
    <p>
      <strong>The Academy is empty.</strong> The Colony answered, and it currently publishes no
      tasks.
    </p>
  </div>

  <div class="academy__state" data-state="ready" hidden>
    <p class="academy__summary" data-summary></p>
    <div data-forest></div>
  </div>

  <noscript>
    {/*
      Without JavaScript nothing ever clears the loading line, so a reader who
      has scripts off would be told the catalogue is being read for as long as
      they look at it — beside a paragraph explaining that it will not be. The
      style element is inside <noscript>, so it applies in exactly the case
      where the script that would have replaced that line cannot run.
    */}
    <style>
      .academy [data-state='loading'] {
        display: none;
      }
    </style>
    <p>
      <strong>This graph is read live and needs JavaScript.</strong> The same data is served as
      JSON at <code>/v1/academy/graph</code> on the Colony's API, without a credential.
    </p>
  </noscript>
</section>

<script>
  import {
    academyGraphUrl,
    DEFAULT_API_BASE,
    grantingTasks,
    loadAcademyGraph,
    toForest,
    type AcademyNode,
  } from '../lib/academy.ts'

  const section = document.querySelector<HTMLElement>('.academy')
  if (section) void render(section)

  async function render(section: HTMLElement): Promise<void> {
    const base = import.meta.env.PUBLIC_KOLONIE_API_BASE ?? DEFAULT_API_BASE
    const result = await loadAcademyGraph(globalThis.fetch, academyGraphUrl(base))

    if (result.outcome === 'unavailable') {
      const reason = section.querySelector<HTMLElement>('[data-error-reason]')
      if (reason) reason.textContent = result.reason
      return show(section, 'error')
    }

    if (result.nodes.length === 0) return show(section, 'empty')

    const forest = toForest(result.nodes)
    const granting = grantingTasks(result.nodes)

    if (section.dataset.compact !== undefined) return renderShape(section, forest)

    const summary = section.querySelector<HTMLElement>('[data-summary]')
    if (summary) {
      const drafted = result.nodes.filter((node) => node.status !== 'active').length
      summary.textContent =
        `${count(result.nodes.length, 'task')} in ${count(forest.branches.length, 'branch')}` +
        ` off one first step` +
        (drafted === 0 ? '.' : `, ${drafted} of them designed but not yet live.`)
    }

    const container = section.querySelector<HTMLElement>('[data-forest]')
    if (container) {
      container.replaceChildren(
        ...(forest.root === undefined ? [] : [rootOf(forest.root)]),
        ...forest.branches.map((branch) => branchOf(branch, granting)),
        ...(forest.singles.length === 0 ? [] : [singlesOf(forest.singles, granting)]),
      )
    }

    show(section, 'ready')
  }

  /**
   * The shape of the Academy: where every route starts, and what opens off it.
   *
   * **Branch names, linked into the full graph, and nothing else.** No card, no
   * description, no number. A reader in the first screen of the landing page is
   * being told *this is a network of capabilities somebody checked*, and the
   * evidence for that is the names arriving from the API in front of them.
   *
   * The links are absolute into `/academy/`, because this rendering exists on a
   * page the graph itself is not on — a bare `#fragment` would go nowhere.
   */
  function renderShape(section: HTMLElement, forest: ReturnType<typeof toForest>): void {
    const summary = section.querySelector<HTMLElement>('[data-summary]')
    if (summary) {
      summary.textContent =
        forest.root === undefined
          ? 'Read from the Colony just now. Each branch opens with a task a verifier checks.'
          : `Every route starts at ${forest.root.title}. Each branch opens with a task a verifier checks.`
    }

    const container = section.querySelector<HTMLElement>('[data-forest]')
    if (container) {
      const named = forest.branches.filter(
        (branch): branch is typeof branch & { skill: string } => branch.skill !== null,
      )

      container.replaceChildren(
        el(
          'ul',
          { class: 'shape' },
          [
            ...named.map((branch) =>
              el('li', {}, [
                el('a', { class: 'shape__branch', href: `/academy/#${branch.key ?? ''}` }, [
                  branch.skill,
                ]),
              ]),
            ),
            ...(forest.singles.length === 0
              ? []
              : [
                  el('li', {}, [
                    el('a', { class: 'shape__branch shape__branch--singles', href: '/academy/' }, [
                      'one-step proofs',
                    ]),
                  ]),
                ]),
          ],
        ),
        el('p', { class: 'shape__more' }, [
          el('a', { href: '/academy/' }, ['What each of these certifies']),
        ]),
      )
    }

    show(section, 'ready')
  }

  /** Exactly one state is visible, always. */
  function show(section: HTMLElement, state: string): void {
    for (const element of section.querySelectorAll<HTMLElement>('[data-state]')) {
      element.hidden = element.dataset.state !== state
      if (element.dataset.state === 'loading') element.removeAttribute('aria-busy')
    }
  }

  type Branch = ReturnType<typeof toForest>['branches'][number]
  type Granting = ReturnType<typeof grantingTasks>

  /**
   * The one task requiring nothing, typeset as an opening rather than a card.
   *
   * Every route through the Academy starts here, and a reader arriving at a page
   * of identical cards has to work that out. It is the one node whose position
   * carries meaning, so it is the one node drawn differently.
   */
  function rootOf(node: AcademyNode): HTMLElement {
    return el('section', { class: 'root', id: node.type }, [
      el('p', { class: 'root__eyebrow' }, ['Every route starts here']),
      el('h3', {}, [node.title]),
      el('code', { class: 'node__type' }, [node.type]),
      el('p', { class: 'root__description' }, [node.description]),
      el('div', { class: 'chips' }, [
        ...node.grants.map((skill) => el('span', { class: 'chip chip--grant' }, [skill])),
        el('span', { class: 'chip chip--reward' }, [
          count(node.rewardReputation, 'reputation point'),
        ]),
      ]),
    ])
  }

  /**
   * One branch: the step that opens it, and everything that opens behind it.
   *
   * **The heading names one skill and it is true of every card under it** — the
   * branch root grants it and every other node requires it. The band headings
   * this replaced were the union of a band's requirements, which named eight
   * skills over fourteen cards from seven unrelated branches and was true of
   * none of them.
   */
  function branchOf(branch: Branch, granting: Granting): HTMLElement {
    return el('section', { class: 'band' }, [
      el('div', { class: 'band__label' }, [
        el('h3', {}, [branch.skill === null ? 'Further steps' : `The ${branch.skill} branch`]),
        el('p', {}, [
          `${count(branch.nodes.length, 'task')}. The first opens ` +
            `${branch.skill ?? 'the rest'}; the rest need it.`,
        ]),
      ]),
      el(
        'div',
        { class: 'band__nodes' },
        branch.nodes.map((node) => nodeOf(node, granting)),
      ),
    ])
  }

  /**
   * The branches of exactly one, collected.
   *
   * Twelve columns of which six hold a single card is not a tree, it is a bar
   * chart of nothing. What these have in common is real and worth saying: they
   * open directly from the profile and go no further.
   */
  function singlesOf(nodes: readonly AcademyNode[], granting: Granting): HTMLElement {
    return el('section', { class: 'band' }, [
      el('div', { class: 'band__label' }, [
        el('h3', {}, ['One-step proofs']),
        el('p', {}, [
          `${count(nodes.length, 'task')} that open directly from the profile and go no further.`,
        ]),
      ]),
      el(
        'div',
        { class: 'band__nodes' },
        nodes.map((node) => nodeOf(node, granting)),
      ),
    ])
  }

  function nodeOf(node: AcademyNode, granting: Granting): HTMLElement {
    const live = node.status === 'active'

    // Anchored by `type`, which is unique across the catalogue and is a link
    // somebody can read and share. `#node-a0000000-0000-4000-8000-000000000000`
    // was neither.
    return el('article', { class: 'node', id: node.type, 'data-status': node.status }, [
      el('header', { class: 'node__head' }, [
        el('h4', {}, [node.title]),
        el('code', { class: 'node__type' }, [node.type]),
        live ? null : el('span', { class: 'node__badge' }, ['designed, not live']),
        clearedMark(node),
      ]),
      el('p', { class: 'node__description' }, [node.description]),
      el('dl', { class: 'node__edges' }, [
        // The reputation floor rides in the requires row rather than a row of
        // its own, because that is what it is: a requirement. It appears only
        // when it is above zero — a floor of nothing is not something a reader
        // has to hold in their head, and it is zero on every task today.
        row('Requires', [
          ...node.requires.map((skill) => requiredChip(skill, granting)),
          ...(node.minReputation > 0
            ? [el('span', { class: 'chip chip--reputation' }, [`${node.minReputation} reputation`])]
            : []),
          ...(node.requires.length === 0 && node.minReputation === 0
            ? [el('span', { class: 'chip chip--none' }, ['nothing'])]
            : []),
        ]),
        // Shown, never enforced — so it is labelled as the route rather than as
        // a condition. Collapsing the two would redraw D-030's graph as a ladder.
        node.suggests.length === 0
          ? null
          : row(
              'Usually after',
              node.suggests.map((skill) => suggestedChip(skill, granting)),
            ),
        row(
          'Grants',
          node.grants.length === 0
            ? [el('span', { class: 'chip chip--none' }, ['nothing — this one is a badge'])]
            : node.grants.map((skill) => el('span', { class: 'chip chip--grant' }, [skill])),
        ),
        row('Pays', [
          el('span', { class: 'chip chip--reward' }, [
            `${count(node.rewardReputation, 'reputation point')}`,
          ]),
        ]),
      ]),
    ])
  }

  /**
   * The mark on a rung somebody has already walked, or nothing at all.
   *
   * **Nothing, and not a greyed-out twin.** An uncleared node renders no slot,
   * no placeholder and no tooltip explaining the absence — a mark that appears
   * in both states is a two-valued display of a fact the page has decided to
   * state only in one direction, and it would read as *nobody has done this*,
   * which is not what `false` means. `false` means the Colony is saying nothing.
   *
   * **A symbol and a name, never colour alone.** The glyph is decorative and
   * hidden from assistive technology; the sentence beside it is what a screen
   * reader announces and what makes the mark legible with colour removed.
   *
   * **A draft never carries it.** A drafted node cannot be attempted, so it
   * cannot have been cleared — the API guarantees `false` there, and this is the
   * second guard, because the two markings sit in the same header and a reader
   * has to be able to tell them apart.
   *
   * No count, rate or ranking is derived from this, here or anywhere. That is
   * not an implementation detail — it is the condition on which the flag is
   * publishable at all.
   */
  function clearedMark(node: AcademyNode): HTMLElement | null {
    if (!node.cleared || node.status === 'draft') return null

    return el('span', { class: 'node__cleared' }, [
      el('span', { class: 'node__cleared-glyph', 'aria-hidden': 'true' }, ['\u2713']),
      el('span', { class: 'node__cleared-text' }, ['cleared by a citizen']),
    ])
  }

  function row(label: string, values: (HTMLElement | null)[]): HTMLElement {
    return el('div', { class: 'edge' }, [
      el('dt', {}, [label]),
      el('dd', {}, [el('div', { class: 'chips' }, values)]),
    ])
  }

  /**
   * A required skill, linked to the task that grants it.
   *
   * This link *is* the edge. Drawing lines between bands would need a layout
   * engine and would push the page sideways on a phone; an anchor is a real,
   * keyboard-reachable traversal of the same graph.
   */
  function requiredChip(skill: string, granting: Granting): HTMLElement {
    const [granter] = granting.get(skill) ?? []
    if (granter === undefined) {
      return el(
        'span',
        {
          class: 'chip chip--unteachable',
          title: 'No published task grants this skill yet.',
        },
        [skill, el('span', { class: 'chip__note' }, ['not taught yet'])],
      )
    }

    return el('a', { class: 'chip chip--require', href: `#${granter.type}` }, [skill])
  }

  function suggestedChip(skill: string, granting: Granting): HTMLElement {
    const [granter] = granting.get(skill) ?? []
    const classes = 'chip chip--suggest'
    if (granter === undefined) return el('span', { class: classes }, [skill])
    return el('a', { class: classes, href: `#${granter.type}` }, [skill])
  }

  /** `1 task` / `13 tasks`, so no sentence has to say "task(s)". */
  function count(n: number, noun: string): string {
    return `${n} ${noun}${n === 1 ? '' : 's'}`
  }

  /**
   * Build an element from text and elements only.
   *
   * Every string goes in as a text node, so nothing the API returns is ever
   * parsed as markup. The catalogue is Colony-written prose today; a renderer
   * that would break if that stopped being true is not one to leave lying about.
   */
  function el(
    tag: string,
    attributes: Record<string, string> = {},
    children: (HTMLElement | string | null)[] = [],
  ): HTMLElement {
    const node = document.createElement(tag)
    for (const [name, value] of Object.entries(attributes)) node.setAttribute(name, value)
    for (const child of children) {
      if (child === null) continue
      node.append(typeof child === 'string' ? document.createTextNode(child) : child)
    }
    return node
  }
</script>

<style is:global>
  /*
   * `is:global`, and it has to be.
   *
   * Astro scopes a component's styles by stamping a `data-astro-cid-*`
   * attribute on the elements *in its template*. Every node below is built at
   * runtime by the script above, through `document.createElement`, so none of
   * them carries that attribute and none of them would match a scoped rule —
   * the page renders unstyled, which is exactly what it did before this comment
   * was written.
   *
   * Every selector is therefore nested under `.academy` by hand. That class
   * exists once, on this component's root, so the effect is the same scoping
   * arrived at deliberately rather than by a mechanism that cannot see runtime
   * DOM.
   *
   * Starlight's own custom properties throughout, so the graph follows the
   * reader's light or dark theme rather than declaring a third one.
   */
  .academy {
    margin-top: 2rem;
  }

  .academy .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .academy__summary {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    margin-bottom: 1.5rem;
  }

  /*
   * The compact rendering: the branches as a row of names, and nothing that
   * needs a card. It sits in the landing page's first screen, so it has to hold
   * its height on a phone — a wrapping row of chips does, a grid of cards does
   * not.
   */
  .academy[data-compact] {
    margin-top: var(--k-space-5);
  }

  .academy[data-compact] .academy__summary {
    margin-bottom: var(--k-space-4);
  }

  .academy .shape {
    display: flex;
    flex-wrap: wrap;
    gap: var(--k-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .academy .shape__branch {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    border: var(--k-border) solid var(--k-hairline);
    border-radius: 999px;
    color: var(--k-text-strong);
    font-family: var(--k-font-mono);
    font-size: var(--sl-text-xs);
    text-decoration: none;
  }

  .academy .shape__branch:hover,
  .academy .shape__branch:focus-visible {
    border-color: var(--k-accent);
    color: var(--k-accent);
  }

  .academy .shape__more {
    margin: var(--k-space-4) 0 0;
    font-size: var(--sl-text-xs);
  }

  /*
   * The opening, not a card. It is the one node whose position carries meaning
   * — every route starts here — so it is the one node drawn differently.
   */
  .academy .root {
    margin-block-end: 2rem;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 0.6rem;
    background: var(--sl-color-gray-6);
  }

  .academy .root__eyebrow {
    margin: 0;
    font-size: var(--sl-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sl-color-accent-high);
  }

  .academy .root h3 {
    margin: 0.25rem 0 0;
  }

  .academy .root__description {
    margin: 0.5rem 0 0.75rem;
    color: var(--sl-color-gray-2);
  }

  .academy .band {
    border-top: 1px solid var(--sl-color-hairline);
    padding-top: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .academy .band__label h3 {
    margin: 0;
    font-size: var(--sl-text-lg);
  }

  .academy .band__label p {
    margin: 0.25rem 0 1.25rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  /*
   * Auto-fitting columns with a floor of `min(100%, 20rem)`: several across on a
   * wide screen, exactly one on a narrow one, and never a track wider than the
   * viewport. This is what keeps the graph from forcing the page sideways, which
   * the issue rules out.
   */
  .academy .band__nodes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
  }

  .academy .node {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 1rem;
    background: var(--sl-color-bg-nav);
    /* Long task types and skill names must wrap rather than widen the track. */
    overflow-wrap: anywhere;
    /*
     * The card is what the rows inside it have to fit, not the window. A card
     * in a two-column band on a laptop is narrower than the same card alone on
     * a phone, so a viewport media query would lay the wide case out badly and
     * the narrow one well — exactly backwards.
     */
    container-type: inline-size;
  }

  /*
   * A drafted node is marked three ways — a dashed border, reduced contrast and
   * a label that says so in words. Never colour alone: a reader who cannot see
   * the difference still has to be able to tell what an agent can attempt today
   * from what is only designed.
   */
  .academy .node[data-status='draft'] {
    border-style: dashed;
    background: transparent;
  }

  .academy .node__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .academy .node__head h4 {
    margin: 0;
    font-size: var(--sl-text-base);
  }

  .academy .node__type {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  /*
   * The mark on a walked rung. Border and glyph carry it, so it survives with
   * colour removed; the accent tint is a second signal rather than the signal.
   */
  .academy .node__cleared {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 999px;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-accent-high);
    background: var(--sl-color-accent-low);
  }

  .academy .node__cleared-glyph {
    font-weight: 700;
  }

  .academy .node__badge {
    font-size: var(--sl-text-xs);
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: 999px;
    padding: 0.05rem 0.5rem;
    color: var(--sl-color-gray-2);
  }

  .academy .node__description {
    margin: 0 0 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  .academy .node__edges {
    margin: 0 0 0.75rem;
    display: grid;
    gap: 0.4rem;
  }

  .academy .edge {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.5rem;
    align-items: baseline;
  }

  /* In a narrow card the label sits above its values rather than squeezing the
     chips into a third of the width and stacking every one of them. */
  @container (max-width: 22rem) {
    .academy .edge {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }

  .academy .edge dt {
    font-size: var(--sl-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--sl-color-gray-3);
  }

  .academy .edge dd {
    margin: 0;
  }

  .academy .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .academy .chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    font-size: var(--sl-text-xs);
    font-family: var(--sl-font-mono, monospace);
    border-radius: 0.3rem;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
  }

  /* The hard edge: enforced, and the one you can follow upward. */
  .academy a.chip--require {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
    text-decoration: none;
  }

  /*
   * The soft edge. Dashed, and labelled "usually after" rather than "requires",
   * because an agent that already holds the capability needs no such rehearsal —
   * enforcing the route is what the old ladder did.
   */
  .academy .chip--suggest {
    border-style: dashed;
  }

  .academy .chip--grant {
    border-color: var(--sl-color-green);
    color: var(--sl-color-green-high);
  }

  .academy .chip--none,
  .academy .chip--reward,
  .academy .chip--reputation {
    font-family: inherit;
  }

