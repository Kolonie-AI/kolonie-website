---
/**
 * The header, and there is one (kolonie-website#50).
 *
 * Measured on 2026-08-06 the header held a wordmark, `Sign in` and `GitHub` —
 * three elements, two of them plain underlined links, on a site with five pages
 * a stranger can arrive on and no way to reach four of them from the sixth.
 *
 * The shape is the reference's, with our own items in it, and the two
 * structural facts `#50` names are what it is arranged around: **identity at
 * the edges and navigation in the middle**, so the eye lands on the wordmark,
 * crosses the offer and finishes on the thing to click; and **the two
 * right-hand items are buttons rather than links**, which is what makes signing
 * in findable without reading.
 *
 * **The filled button is not this site's primary call to action**, and its
 * sizing follows from that. The primary action is an agent installing the
 * skill, and that lives in the hero (`#52`); `Sign in` is for the human who is
 * coming back.
 *
 * **There is no announcement bar, and that was decided here** (`#50`). The
 * reference carries one. We have nothing to announce, and an empty or filler
 * bar spends the most valuable strip on the page saying nothing — a refusal
 * rather than an omission, so if there is ever something to announce it arrives
 * as its own issue with the thing to announce already in hand.
 *
 * **One component, one surface** (kolonie-website#95). It was two: `Site.astro`
 * rendered it for `/` and a Starlight `Header` override rendered it for every
 * other page, wrapped in the framework's own bar. That wrapper is what `#93`
 * was opened about — it has no container cap, so the header ran the full 2512px
 * of a 2560px window on fourteen pages while their content sat in a 1080px
 * column. The `bare` prop below existed to stop this component drawing a second
 * bar inside that one.
 *
 * Both are gone with the framework. There is one caller, one bar, and the row
 * inside it is capped at `--k-container` on every page — which is `#93`'s
 * criterion, met by deletion rather than by a second rule.
 */

import Button from './Button.astro'
import { inlineMark } from '../lib/mark.ts'
import { DOCS, GITHUB, NAV_LINKS, SEND, SIGN_IN } from '../lib/site-nav.ts'
import AudienceSwitch from './AudienceSwitch.astro'
// The stylesheet as text, so the mark's two baked-in colours can be put back
// as the tokens they came from. `?raw` because this component is bundled —
// `Site.astro` reads the same file the same way, and `theme-tokens.ts` records
// why the other way round is right under Vitest.
import themeCss from '../styles/theme.css?raw'

/**
 * The mark, read out of `public/mark.svg` at build time rather than retyped
 * here. `src/lib/mark.ts` carries the reasoning — inline rather than `<img>`,
 * because this site's theme is a `data-theme` attribute and not a media query.
 */
const MARK = inlineMark(themeCss)

interface Props {
  /**
   * The current path, so the item for it can be marked. Optional: the layout
   * always knows it, and nothing breaks without it.
   */
  pathname?: string
}

const { pathname } = Astro.props

/** `/academy/` is current on `/academy/` and on anything beneath it. */
const isCurrent = (href: string) =>
  pathname !== undefined &&
  href.startsWith('/') &&
  (pathname === href || pathname.startsWith(href))
---

<header class="site-header">
  {/*
    **The row, and the reason it is a wrapper rather than a `max-width` on the
    header itself** (kolonie-website#81).

    Measured on 2026-08-07 at a 2560px viewport: this header ran the full 2560
    and the page's content sat in 960, so the two no longer lined up. `#81`:
    *"Backgrounds and borders may go full-bleed; content may not."*

    Those are two different elements. `.site-header` keeps the background and
    the rule under it, both of which have to reach the window edge or the header
    stops reading as a bar. This row carries the container, and it is the same
    `--k-container` the page and the footer use.

    It is also what `.site-header__panel` is positioned against, so the menu
    drops inside the container rather than against the window.
  */}
  <div class="site-header__row">
  {/*
    The mark and the wordmark are one link, not two beside each other: they are
    one identity and a reader clicking either means the same thing. The SVG is
    injected rather than written, so the geometry has one source — see
    `src/lib/mark.ts`.
  */}
  <a href="/" class="site-header__mark">
    <span class="site-header__mark-svg" set:html={MARK} />
    Kolonie AI
  </a>

  {/*
    A `<details>` and not a script (kolonie-website#50). Below `--k-bp-sm` the
    wordmark and `Sign in` stay in the bar and everything else folds into this;
    above it, the CSS opens the panel permanently and hides the toggle, so the
    same markup is a menu on a phone and a row on a desktop. A scripted menu
    would be a fourth thing on this site that stops working with JavaScript
    off, and the accordion on `/` already made this choice for the same reason
    (`#37`).

    **`Sign in` is outside it rather than inside and repeated.** It has to be in
    the bar at every width, and the obvious way to do that — one copy in the
    panel and a second in the bar, each hidden at the other's width — puts two
    links with the same name in the document. CSS can hide one from the eye and
    not from a screen reader, and *Sign in, Sign in* is a worse header than a
    missing button. One copy, and it simply never folds.
  */}
  <details class="site-header__menu">
    <summary aria-label="Menu">
      <span aria-hidden="true" class="site-header__burger"></span>
    </summary>

    <div class="site-header__panel">
      <nav class="site-header__nav" aria-label="Site">
        {
          NAV_LINKS.map((link) => (
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>

      {/*
        The audience switch (kolonie-website#78). Inside the panel, so it folds
        with everything else below `--k-bp-sm` — `Sign in` is the one thing that
        stays in the bar at every width, and a second permanent control beside it
        is what makes a header stop fitting on a phone.
      */}
      <AudienceSwitch home={pathname === '/'} />

      <div class="site-header__actions">
        {/* A word for a screen reader, an icon for everybody else — the same
            division the sign-in link used before this, and the reason it is a
            word there and a mark here is that no icon means *sign in*. */}
        <a class="site-header__icon" href={GITHUB.href} rel="me">
          <span class="sr-only">{GITHUB.label}</span>
          <svg
            aria-hidden="true"
            viewBox="0 0 16 16"
            width="20"
            height="20"
            fill="currentColor"
          >
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
          </svg>
        </a>

        <Button href={DOCS.href} variant="secondary">{DOCS.label}</Button>
      </div>
    </div>
  </details>

  {/*
    **The filled button describes what a new visitor does** (kolonie-website#87).

    It said `Sign in` from `#40` until then, which is a label for somebody who
    already belongs — on every page, as the one persistent action the site has.
    `#87`: *"The primary action should describe what a **new** visitor is about
    to do."*

    `Sign in` is beside it now rather than gone: a returning visitor is looking
    for those two words and finds them, and a new one is no longer offered them
    as the thing to press. The same pair, in the same order, as the hero's.

    It stays outside the folding panel for `#50`'s reason, unchanged — the
    primary action has to be in the bar at every width.
  */}
  <a class="site-header__returning" href={SIGN_IN.href}>{SIGN_IN.label}</a>

  <Button class="site-header__sign-in" href={SEND.href} variant="primary">
    {SEND.label}
  </Button>

  {/* **There is no search box, and its absence is the decision** — `#21`'s,
      unchanged by `#95`. A search over twelve pages occupies the most valuable
      position on the page to answer a question nobody has, while signalling
      *documentation* to somebody who arrived to find out what this is. `#95`
      removed the index that was being built and shipped for it. */}
  </div>
</header>

<style>
  /* Not one colour value in this file — every one is a token (AGENTS.md). */
  /* Full-bleed, and only the two properties that have to be: a background and
     a rule that stop before the window edge do not read as a bar at all. */
  .site-header {
    border-bottom: var(--k-border) solid var(--k-hairline);
    background: var(--k-surface);
  }

  /* And the content, which does not go full-bleed (kolonie-website#81). One
     container, shared with `.page` and the footer's columns.

     The panel is positioned against this rather than against `.site-header`,
     so the menu opens inside the container instead of against the window. */
  .site-header__row {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--k-space-4);
    max-width: var(--k-container);
    margin: 0 auto;
    padding: var(--k-space-3) var(--k-gutter);
  }

  .site-header__mark {
    display: inline-flex;
    align-items: center;
    gap: var(--k-space-2);
    color: var(--k-text-strong);
    font-family: var(--k-font-mono);
    font-size: var(--k-text-lg);
    font-weight: 500;
    letter-spacing: var(--k-tracking-label);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__mark-svg {
    display: inline-flex;
  }

  /* `:global` because the SVG arrives through `set:html`, which Astro does not
     rewrite — the scoping attribute it adds to compiled markup never reaches
     it, so a plain descendant selector would match nothing. Scoped to the
     wrapper span rather than loose in the sheet.

     Sized in `em`, so the mark tracks the wordmark it stands beside at every
     width instead of being pinned to a pixel count that is right at one of
     them. The shield is taller than a capital and slightly narrower, which is
     what `1.55` is: measured against the cap height of `Kolonie AI` at
     `--k-text-lg`. */
  .site-header__mark-svg :global(svg) {
    display: block;
    width: 1.55em;
    height: 1.55em;
  }

  /* ---- The phone: a bar and a panel under it ----------------------------- */

  /* `margin-left: auto` puts the toggle at the right-hand end of the bar, just
     before the sign-in button that never folds. */
  .site-header__menu {
    margin-left: auto;
  }

  /* Never folds and never wraps: it is the one thing in this bar that has to be
     in the same place on a phone and on a desktop. */
  .site-header__sign-in {
    white-space: nowrap;
  }

  /* Quiet, beside the filled button rather than inside it (kolonie-website#87).
     Text and not an outline button: two bordered controls side by side read as
     two alternatives of the same weight, which is the thing `#87` is undoing.

     Hidden below `--k-bp-sm`, where the bar holds the wordmark, the burger and
     the one action and nothing else fits — the console is reachable from the
     footer of every page, which is where `#40` put it as well. */
  .site-header__returning {
    display: none;
    color: var(--k-text-muted);
    font-size: var(--k-type-small);
    white-space: nowrap;
    text-decoration: none;
  }

  .site-header__returning:hover,
  .site-header__returning:focus-visible {
    color: var(--k-accent);
  }

  .site-header__menu summary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: var(--k-border) solid var(--k-hairline-strong);
    border-radius: var(--k-radius);
    cursor: pointer;
    list-style: none;
  }

  .site-header__menu summary::-webkit-details-marker {
    display: none;
  }

  .site-header__menu summary:focus-visible {
    outline: 2px solid var(--k-accent);
    outline-offset: 3px;
  }

  /* Three lines, drawn rather than shipped as an asset: `#11` refused
     illustration, and a burger is a control rather than a picture. */
  .site-header__burger,
  .site-header__burger::before,
  .site-header__burger::after {
    display: block;
    width: 1rem;
    height: var(--k-border);
    background: var(--k-text-strong);
  }

  .site-header__burger::before,
  .site-header__burger::after {
    content: '';
    position: relative;
  }

  .site-header__burger::before {
    top: -0.3rem;
  }

  .site-header__burger::after {
    top: 0.3rem;
  }

  /* The panel drops out of the bar rather than pushing it down, so opening the
     menu does not move the page under the reader's thumb. */
  .site-header__panel {
    position: absolute;
    z-index: 20;
    inset-inline: 0;
    display: flex;
    flex-direction: column;
    gap: var(--k-space-4);
    padding: var(--k-space-5) var(--k-gutter);
    border-bottom: var(--k-border) solid var(--k-hairline);
    background: var(--k-surface);
  }

  .site-header__nav {
    display: flex;
    flex-direction: column;
    gap: var(--k-space-4);
  }

  .site-header__nav a {
    color: var(--k-text-muted);
    font-family: var(--k-font-mono);
    font-size: var(--k-type-small);
    letter-spacing: var(--k-tracking-label);
    text-decoration: none;
  }

  .site-header__nav a:hover {
    color: var(--k-text-strong);
  }

  /* The page you are on, marked rather than merely styled: `aria-current` is
     what a screen reader announces, and the colour follows it instead of being
     set separately and going out of step with it. */
  .site-header__nav a[aria-current='page'] {
    color: var(--k-text-strong);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--k-space-3);
  }

  .site-header__icon {
    display: inline-flex;
    color: var(--k-text-muted);
  }

  .site-header__icon:hover {
    color: var(--k-text-strong);
  }

  /* ---- What opens up once there is room ---------------------------------- */

  /* Above `--k-bp-sm` there is no menu: the toggle is gone, the panel is a row
     in the bar, and the standalone `Sign in` that was holding the phone bar
     together is hidden because the real one is now visible.

     **The `open` attribute is not consulted**, deliberately. The panel is shown
     by this rule whatever state the `<details>` is in, so a reader who opened
     the menu on a phone and then turned the device sideways does not arrive at
     a panel hanging under a header that had room for it all along. */
  @media (min-width: 40rem) {
    .site-header__row {
      padding-block: var(--k-space-4);
    }

    .site-header__menu {
      flex: 1;
      margin-left: 0;
    }

    .site-header__menu summary {
      display: none;
    }

    /* There is room for it here, and this is where a returning visitor looks. */
    .site-header__returning {
      display: inline;
    }

    /* **Both, and neither is redundant.** How a browser hides a closed
       `<details>` changed: older engines set `display: none` on the children,
       which the rule below overrides, and newer ones hide `::details-content`
       with `content-visibility`, which it does not. A desktop reader whose
       phone-width visit left the menu closed would find an empty header on one
       of the two. An engine that does not know the pseudo-element ignores that
       rule and is served by the other. */
    .site-header__menu::details-content {
      content-visibility: visible;
      block-size: auto;
    }

    .site-header__panel {
      position: static;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--k-space-5);
      padding: 0;
      border: 0;
      background: transparent;
    }

    .site-header__nav {
      flex-direction: row;
      gap: var(--k-space-5);
      /* The middle, which is the half of the reference's shape that matters:
         the eye lands on the wordmark, crosses the offer, and finishes on the
         thing to click. */
      margin-inline: auto;
    }
  }
</style>
