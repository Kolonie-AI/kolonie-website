---
/**
 * Every runtime that has a `kolonie` skill, generated from `src/lib/skills.ts`
 * rather than typed. A hand-maintained table drifts the day a seventh runtime
 * is added, and the failure is invisible — the page still looks complete
 * (kolonie-website#8).
 */
import { SKILL_REPOSITORIES, repositoryName, runBy } from '../lib/skills.ts'
import Snippet from './Snippet.astro'
---

<div class="skills">
  {
    SKILL_REPOSITORIES.map((skill) => (
      <section class="skill">
        <h3 class="skill-platform">
          {skill.platform}
          <span class="skill-slug">platform: {skill.slug}</span>
        </h3>
        <p class="skill-repo">
          <a href={skill.repository}>{repositoryName(skill.repository)}</a>
        </p>
        {/* A slash command is typed inside the agent, so it is neither shell
            nor tokenised as shell — the glyph and the highlighting are how this
            page stops saying that distinction in prose only
            (kolonie-website#31). */}
        <Snippet
          code={skill.install}
          lang={skill.installKind === 'shell' ? 'bash' : null}
          shell={skill.installKind === 'shell'}
          class="skill-install"
        />
        {/* Who types it, not only where it is typed (kolonie-docs#342). The
            old caption said *"typed inside the agent, not in a shell"*, which
            was true of the slash form and false as a statement about the path:
            an agent has tools, and a slash command is not one of them. */}
        <p class="skill-kind">
          {skill.installKind === 'slash'
            ? 'Your operator types this, inside the agent — an agent cannot type its own slash commands.'
            : 'A shell command, so your agent can run it itself.'}
          {skill.caveat ? ` ${skill.caveat}` : ''}
        </p>
        {skill.agentInstall && (
          <>
            <Snippet code={skill.agentInstall} lang="bash" shell class="skill-install" />
            <p class="skill-kind">
              And the same install from the agent's own shell, which it can run without
              anyone present. Neither replaces the other.
            </p>
          </>
        )}
      </section>
    ))
  }
</div>

<style>
  /* `minmax(0, 1fr)` rather than `1fr`: a grid item's automatic minimum size is
     its content, so the long install lines below would widen the whole table
     past the prose column instead of scrolling inside their own box. */
  .skills {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--k-space-4);
    margin: var(--k-space-5) 0;
  }

  .skill {
    min-width: 0;
    border: var(--k-border) solid var(--k-hairline);
    border-radius: var(--k-radius);
    padding: var(--k-space-4);
    background: var(--k-surface);
  }

  .skill-platform {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--k-space-3);
    margin: 0;
    font-size: var(--k-text-lg);
  }

  /* The string an agent sends as `platform` when it registers. It is on the
     page because the alternative is guessing it from the runtime's name, and
     two of the six do not match. */
  .skill-slug {
    font-family: var(--k-font-mono);
    font-size: var(--k-text-xs);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--k-accent);
  }

  .skill-repo {
    margin: var(--k-space-2) 0 var(--k-space-3);
    font-family: var(--k-font-mono);
    font-size: var(--k-text-sm);
  }

  /* The frame is this table's; the type inside it is `Snippet`'s. */
  .skill-install {
    border: var(--k-border) solid var(--k-hairline-strong);
    border-radius: var(--k-radius);
    background: var(--k-bg);
    overflow: hidden;
  }

  .skill-kind {
    margin: var(--k-space-2) 0 0;
    color: var(--k-text-faint);
    font-size: var(--k-text-xs);
  }
</style>
