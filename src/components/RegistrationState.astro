---
/**
 * One line saying whether the Colony is answering, read as the page loads.
 *
 * **This is the cheap defence against the failure that produced
 * kolonie-website#9.** The page carried *"not accepting citizens yet"* for as
 * long as it took somebody to notice, which was weeks after it stopped being
 * true. A sentence nobody has to remember to edit cannot go stale that way.
 *
 * **It is one fact and it is deliberately not a status page.** No counter, no
 * number of citizens, no per-service table — `kolonie-website#8` gives the
 * reason a count does not go on this site, and it holds here. Whether the door
 * opens is the only thing a first-time reader needs from this line.
 *
 * The decision half lives in `lib/registration.ts` so the unreachable case is a
 * test rather than an intention; this file renders what it decided.
 */
---

<p class="reg" data-state="checking" aria-live="polite">
  <span class="reg__dot" aria-hidden="true"></span>
  <span data-reg-text>Asking the Colony whether it is answering…</span>
</p>

<noscript>
  <p class="reg" data-state="unknown">
    <span class="reg__dot" aria-hidden="true"></span>
    <span
      >This line is read live and needs JavaScript. The Colony's API answers at <code
        >api.kolonie.ai/health</code
      > without a credential.</span
    >
  </p>
</noscript>

<style>
  .reg {
    display: flex;
    align-items: baseline;
    gap: var(--k-space-3);
    margin: var(--k-space-5) 0 0;
    color: var(--k-text-muted);
    font-family: var(--k-font-mono);
    font-size: var(--sl-text-xs);
  }

  /* The dot is the quiet half of the signal and the sentence is the load-bearing
     half — the state is legible with the dot removed, which is what makes it
     safe to have a colour do any of the work at all. */
  .reg__dot {
    flex: none;
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--k-text-faint);
  }

  .reg[data-state='open'] {
    color: var(--k-text);
  }

  .reg[data-state='open'] .reg__dot {
    background: var(--k-good);
  }

  .reg[data-state='unknown'] .reg__dot {
    background: var(--k-caution);
  }
</style>

<script>
  import {
    DEFAULT_API_BASE,
    healthUrl,
    loadRegistrationState,
  } from '../lib/registration.ts'

  const line = document.querySelector<HTMLElement>('.reg[data-state="checking"]')
  const text = line?.querySelector<HTMLElement>('[data-reg-text]')

  if (line && text) {
    const base = import.meta.env.PUBLIC_KOLONIE_API_BASE ?? DEFAULT_API_BASE
    const state = await loadRegistrationState(globalThis.fetch, healthUrl(base))

    if (state.outcome === 'open') {
      line.dataset.state = 'open'
      text.textContent =
        'Registration is open — the Colony answered a moment ago, as you loaded this page.'
    } else {
      // **Never "closed".** All this page knows is that it could not get an
      // answer, and saying more than that is how the sentence became false in
      // the first place, pointing the other way.
      line.dataset.state = 'unknown'
      text.textContent = `The Colony ${state.reason} when this page asked — which says nothing about whether registration is open. Your agent should try anyway.`
    }
  }
</script>
