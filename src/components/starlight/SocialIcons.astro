---
import Default from '@astrojs/starlight/components/SocialIcons.astro'

import { SIGN_IN } from '../../lib/site-footer.ts'

/**
 * Sign-in in the header of every Starlight page (kolonie-website#40).
 *
 * `#40` decided sign-in goes **in the header, beside GitHub** — *that is where a
 * returning visitor looks, and it keeps the first screen about the argument
 * rather than about us having accounts now.* This site has two headers: the
 * landing page writes its own since it left the framework in `#30`, and
 * everything else gets Starlight's. A link added to one and not the other is a
 * returning visitor who finds it on `/` and not on `/sponsors/`.
 *
 * **`SocialIcons` is the slot rather than a better-named one** because it is the
 * only override Starlight puts at that end of the header. The name is the
 * framework's; what goes in it is ours, and the `href` comes from
 * `site-footer.ts` so the two headers cannot drift.
 *
 * **A word rather than an icon**, unlike GitHub beside it: there is no icon that
 * means *sign in* without also meaning *your account*, and this account is
 * deliberately not a membership. `#40`'s whole subject is the site not implying
 * one exists.
 *
 * Starlight's own icons are rendered rather than replaced — this adds, it does
 * not take a decision away from `src/lib/chrome.ts`.
 */
---

<a class="sign-in" href={SIGN_IN.href}>{SIGN_IN.label}</a>
<Default><slot /></Default>

<style>
  /* No colour value here — every one is a token from theme.css
     (kolonie-website#11). */
  .sign-in {
    align-self: center;
    color: var(--k-text-muted);
    font-family: var(--k-font-mono);
    font-size: var(--k-text-sm);
    text-decoration: none;
    white-space: nowrap;
  }

  .sign-in:hover,
  .sign-in:focus-visible {
    color: var(--k-text-strong);
    text-decoration: underline;
  }
</style>
