---
import Default from '@astrojs/starlight/components/Footer.astro'

import SiteFooter from '../SiteFooter.astro'

/**
 * The footer on every Starlight page (kolonie-website#42, #51).
 *
 * `#42` and `#44` both require their page linked from the footer of **every**
 * page, and this site has two surfaces: the landing page left the framework in
 * `#30` and everything else did not. Since `#51` they render the same
 * component, so there is nothing left here to keep in agreement — this file is
 * the seam and holds no markup of its own.
 *
 * **Starlight's own footer is rendered rather than replaced.** On a
 * documentation page it carries the edit link, the last-updated line and the
 * pagination, which `src/lib/chrome.ts` already suppresses on the pages a
 * stranger arrives on. This adds a block; it does not take a decision away from
 * that file.
 */
---

<Default><slot /></Default>

<SiteFooter />
