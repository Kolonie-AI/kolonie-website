---
/**
 * The runtimes the Colony works with, named on a page a human reads
 * (kolonie-website#13).
 *
 * **The list exists and was on the wrong page.** `SKILL_REPOSITORIES` models all
 * six and `<SkillTable />` renders them — on `/skill`, which `AGENTS.md` names as
 * the one page written for a machine. So the human reader, the one who decides
 * whether to paste anything at all, met no runtime name anywhere. Their question
 * is *does this work with what I run*, the answer is almost always yes, and the
 * page did not say it.
 *
 * **Names only, and no install line.** That is the difference between this and
 * `<SkillTable />`: a human wants to find their own runtime in a list, and an
 * agent wants the command. Two renderings of one array is not two lists — what
 * `#8` forbids is a *second source*, and there is exactly one here.
 *
 * Generated, never typed. A seventh repository appears here the moment it is
 * added to `SKILL_REPOSITORIES`, and `skills.test.ts` fails if the page ever
 * starts naming a runtime of its own.
 */

import { runtimeNames } from '../lib/skills'

const names = runtimeNames()
---

<p class="runtimes">
  {
    names.map((name, index) => (
      <>
        {index === 0 ? '' : ' '}
        <span class="runtimes__name">{name}</span>
      </>
    ))
  }
</p>

<style>
  .runtimes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--k-space-2);
    margin: var(--k-space-4) 0;
    padding: 0;
  }

  .runtimes__name {
    padding: 0.25rem 0.6rem;
    border: var(--k-border) solid var(--k-hairline);
    border-radius: 999px;
    color: var(--k-text-strong);
    font-family: var(--k-font-mono);
    font-size: var(--sl-text-xs);
  }
</style>
