---
/**
 * The shell for the pages that are not documents (kolonie-website#30, #49).
 *
 * **It was `Landing.astro` and served one page until `#49`.** The legal pages
 * rendered through `StarlightPage`, which brought the framework's own light
 * theme with it — two design systems on one domain, one click apart in the
 * footer. `[legal].astro`'s own comment already said a legal page *"is a page a
 * stranger arrives on rather than documentation"*, which is `#21`'s rule, and
 * then called `StarlightPage` anyway. They render through this instead, and the
 * name follows what the file is: the site's layout, not the landing page's.
 *
 * `/` was `src/content/docs/index.mdx` with `template: splash`: a Markdown file
 * rendered by a documentation framework, which meant a hero of a centred title
 * and up to two buttons, a body that could only be a stream of `##` headings,
 * and — on the most important page on the site — a documentation pager reading
 * *Next → The Academy*. `#21` set out to remove that furniture and this was the
 * page it survived on.
 *
 * **This is one page leaving, not a framework migration.** `/academy`,
 * `/skill`, `/quests`, `/who-builds-this` and `/blog` are documents, are well
 * served by being documents, and stay on Starlight. What that costs is this
 * file: the base layer Starlight was providing — the element styles, the skip
 * link, the header — has to exist here instead. It is written against the same
 * tokens in `src/styles/theme.css`, so the two surfaces cannot drift into two
 * designs, and there is not a colour value in this file.
 *
 * **Dark only, and only here.** Decided by the maintainer on 2026-08-05: both
 * references are dark-only, the brand is terminal-adjacent, and a light theme
 * is a second design that will always be the worse one. `#22` chose *follow the
 * system* and that was right for a documentation site. The documentation pages
 * keep both themes and `theme.test.ts` keeps checking both — which is why the
 * light block in `theme.css` is not dead code and must not be removed on the
 * strength of this layout.
 *
 * `#49` widened *only here* from one page to five and did not reopen the
 * decision: a legal page reached from a dark footer is a page a reader arrived
 * at from the dark site, and it was the odd one out rather than the exception.
 */

import { PAGESENSE_ATTRS } from '../lib/analytics'
import {
  FONT_PRELOADS,
  OG_IMAGE,
  OG_IMAGE_ALT,
  SITE,
  themeColorFrom,
} from '../lib/head'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import '../styles/theme.css'
// The same file again, as text, because `<meta name="theme-color">` needs the
// value rather than the variable. `?raw` rather than `readFileSync`: this
// module is bundled, and at build time a path relative to it points into
// `dist/.prerender/`, where `theme.css` is not.
import themeCss from '../styles/theme.css?raw'

interface Props {
  /** The `<title>`, before the site name is appended. */
  title: string
  description: string
}

const { title, description } = Astro.props

const canonical = new URL(Astro.url.pathname, SITE).href
const themeColor = themeColorFrom(themeCss)
---

<!doctype html>
{/* `data-theme="dark"` is written into the markup rather than chosen at
     runtime: this page has one theme, so there is no preference to read and no
     flash of the wrong one to avoid. */}
<html lang="en" dir="ltr" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Kolonie AI</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="shortcut icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* The same two files the Starlight pages preload, from the same list
        (kolonie-website#48) — the reason `sharedHeadTags` exists at all is that
        this page writes its own head and quietly losing a tag here is the
        failure that costs most. */}
    {FONT_PRELOADS.map((href) => (
      <link
        rel="preload"
        href={href}
        as="font"
        type="font/woff2"
        crossorigin="anonymous"
      />
    ))}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kolonie AI" />
    <meta property="og:locale" content="en" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={themeColor} />

    {/* Zoho PageSense, on every page of this site and on no host that serves a
         token (kolonie-website#17). `analytics.built-test.ts` reads the built
         output and fails if a page is missing it, which is what makes leaving
         the framework safe to do at all. */}
    {/* `is:inline` so Astro leaves it exactly as written: the tag has to reach
         the browser as a deferred external script, not as something bundled. */}
    <script is:inline {...PAGESENSE_ATTRS}></script>

    {/*
      Arms the scroll reveal before first paint (kolonie-website#34).

      `is:inline` and in `<head>` on purpose. The hidden state in `theme.css` is
      gated on this attribute, so a browser that never runs a script never hides
      anything — the reveal fails open — and running it here rather than in the
      bundled module below means there is no frame where a section is painted
      and then hidden.

      Three lines, and they are the whole of what has to be inline: everything
      that decides *when* to reveal is in the module, where it can be read.
    */}
    <script is:inline>
      document.documentElement.dataset.revealReady = ''
    </script>
  </head>

  <body>
    {/* Not chrome and not optional: `#21` is explicit that removing a
         documentation framework's furniture must not remove its accessibility.
         Starlight was providing this one. */}
    <a href="#main" class="skip-link">Skip to content</a>

    {/* The same component the Starlight pages render, from the same list
        (kolonie-website#50). This page wrote its own header from `#30` until
        then — a wordmark and two links, which is what a header looks like when
        nobody owns it. There is one now, and it is not written here. */}
    <SiteHeader pathname={Astro.url.pathname} />

    <main id="main">
      <slot />
    </main>

    <script>
      /**
       * Sections arrive as they enter the viewport (kolonie-website#34).
       *
       * **Nothing here decides what moves.** The page marks its own sections
       * with `data-reveal`, this only watches them — so the live reads and the
       * Academy graph are excluded by not carrying the attribute rather than by
       * a list here that would go out of date.
       *
       * `once` semantics: an element is unobserved as soon as it has been
       * revealed. A section that faded every time it re-entered the viewport
       * would be a page that never settles, which is the thing `#22` refused
       * under the name decoration.
       */
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]')

      if (targets.length) {
        // No observer — an old browser, or a polyfill nobody shipped. Reveal
        // everything immediately: the failure mode of this feature is that the
        // page is simply the page.
        if (!('IntersectionObserver' in window)) {
          targets.forEach((el) => (el.dataset.revealed = ''))
        } else {
          const seen = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue
                ;(entry.target as HTMLElement).dataset.revealed = ''
                seen.unobserve(entry.target)
              }
            },
            // A small margin so a section is already settled by the time it is
            // properly in view, rather than animating under the reader's eye.
            { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
          )

          targets.forEach((el) => seen.observe(el))
        }
      }
    </script>

    {/* The same component the Starlight pages render (kolonie-website#51).
         This page left the framework in #30 and wrote its own footer until
         then — and two hand-maintained footers is how /privacy/ ends up linked
         from five pages out of six, which is what #42 had to repair. */}
    <SiteFooter />

    <style is:global>
      /*
       * The base layer for the pages that are not documents. Starlight ships one
       * and it comes with Starlight; this is the same job done against the same
       * tokens, and nothing here is a colour value.
       */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        background: var(--k-bg);
        color-scheme: dark;
      }

      body {
        margin: 0;
        background: var(--k-bg);
        color: var(--k-text);
        font-family: var(--k-font-prose);
        /* The role, not the step (kolonie-website#48). This asked for
           `--k-text-base` and set the most-read text on the site two steps
           below the same text on a documentation page one click away. */
        font-size: var(--k-type-body);
        line-height: var(--sl-line-height);
        -webkit-font-smoothing: antialiased;
      }

      h1,
      h2,
      h3,
      h4 {
        color: var(--k-text-strong);
        line-height: var(--sl-line-height-headings);
      }

      h1 {
        font-size: var(--k-type-h1);
      }
      h2 {
        font-size: var(--k-type-h2);
      }
      h3 {
        font-size: var(--k-type-h3);
      }
      h4 {
        font-size: var(--k-text-xl);
      }

      a {
        color: var(--k-accent);
        text-underline-offset: 0.2em;
      }

      strong {
        color: var(--k-text-strong);
        font-weight: 600;
      }

      code {
        font-family: var(--k-font-mono);
        font-size: 0.9em;
        padding: 0.15em 0.35em;
        border-radius: var(--k-radius);
        background: var(--k-surface-raised);
      }

      /* Focus is visible on everything, on a page whose accent is the only
         bright thing in the palette. */
      :is(a, button, summary, input, [tabindex]):focus-visible {
        outline: 2px solid var(--k-accent);
        outline-offset: 3px;
        border-radius: var(--k-radius);
      }

      /* Starlight's, because components written for the documentation pages use
         it and a landing page that dropped it would show the labels those
         components hide. */
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
      }

      .skip-link {
        position: absolute;
        z-index: 10;
        top: var(--k-space-2);
        left: var(--k-space-2);
        padding: var(--k-space-2) var(--k-space-4);
        border: var(--k-border) solid var(--k-hairline-strong);
        border-radius: var(--k-radius);
        background: var(--k-surface);
        font-family: var(--k-font-mono);
        font-size: var(--k-text-sm);
        transform: translateY(-200%);
      }

      .skip-link:focus {
        transform: none;
      }
    </style>

    {/* No styles of its own beyond the base layer above. The header is
         `SiteHeader.astro` (#50) and the footer is `SiteFooter.astro` (#51);
         both carry their own, which is what made it possible for there to be
         one of each rather than one per surface. */}
  </body>
</html>
