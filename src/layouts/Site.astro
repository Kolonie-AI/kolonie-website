---
/**
 * The site's layout. **There is one, and this is it** (kolonie-website#95).
 *
 * It served one page from `#30`, five from `#49`, and every page on the site
 * from `#95`. The line each of those issues moved is the same line: how much of
 * this site a documentation framework was rendering. It is now none of it.
 *
 * `/` was `src/content/docs/index.mdx` with `template: splash`: a Markdown file
 * rendered by a documentation framework, which meant a hero of a centred title
 * and up to two buttons, a body that could only be a stream of `##` headings,
 * and — on the most important page on the site — a documentation pager reading
 * *Next → The Academy*. `#21` set out to remove that furniture and this was the
 * page it survived on.
 *
 * **What `#95` measured is why the rest followed.** Twelve of twelve content
 * pages carried `template: splash`, which switches the framework's layout off;
 * seven components were overridden, four of them to render nothing; no page
 * showed a search control, a sidebar or a table of contents. Every visible part
 * of Starlight had been switched off one override at a time, and what was left
 * was a content column the site did not want. The base layer it had been
 * providing — the element styles, the skip link — is below, written against the
 * same tokens in `src/styles/theme.css`, and there is not a colour value in
 * this file.
 *
 * **Dark only.** Decided by the maintainer on 2026-08-05: both references are
 * dark-only, the brand is terminal-adjacent, and a light theme is a second
 * design that will always be the worse one. `#22` chose *follow the system* and
 * that was right for a documentation site.
 *
 * **The light block in `theme.css` is not dead code and must not be removed on
 * the strength of this layout.** It was kept for the documentation pages until
 * `#95`, and those are gone — what keeps it now is `theme.test.ts`, which
 * computes every text-on-background pair in *both* sets. The palette is checked
 * in a theme the site does not serve so that turning one on is a decision
 * rather than a repair.
 */

import {
  FONT_PRELOADS,
  OG_IMAGE,
  OG_IMAGE_ALT,
  SITE,
  themeColorFrom,
} from '../lib/head'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import '../styles/theme.css'
// The same file again, as text, because `<meta name="theme-color">` needs the
// value rather than the variable. `?raw` rather than `readFileSync`: this
// module is bundled, and at build time a path relative to it points into
// `dist/.prerender/`, where `theme.css` is not.
import themeCss from '../styles/theme.css?raw'

interface Props {
  /** The `<title>`, before the site name is appended. */
  title: string
  description: string
}

const { title, description } = Astro.props

const canonical = new URL(Astro.url.pathname, SITE).href
const themeColor = themeColorFrom(themeCss)
---

<!doctype html>
{/* `data-theme="dark"` is written into the markup rather than chosen at
     runtime: this page has one theme, so there is no preference to read and no
     flash of the wrong one to avoid. */}
<html lang="en" dir="ltr" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Kolonie AI</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="shortcut icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* The Android half of a home-screen icon (`#62`). It carries no `display`
        field, so nothing here claims this site is an application —
        `scripts/build-assets.mjs` records that refusal beside the rest of the
        manifest.

        `/favicon.ico` is deliberately *not* declared beside it. That file
        exists for clients that request the path without reading this head at
        all, and offering it here would let a browser prefer 48 fixed pixels to
        a vector. */}
    <link rel="manifest" href="/site.webmanifest" />

    {/* The two font files a page needs before it paints (kolonie-website#48).
        The list is `FONT_PRELOADS` in `src/lib/head.ts`, which is where it went
        when there were two surfaces writing a head and one of them could
        quietly lose a tag. There is one now and the list stays there: it is
        read by `fonts.built-test.ts`, and a preload asserted against a constant
        is a stronger check than one asserted against a copy. */}
    {FONT_PRELOADS.map((href) => (
      <link
        rel="preload"
        href={href}
        as="font"
        type="font/woff2"
        crossorigin="anonymous"
      />
    ))}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kolonie AI" />
    <meta property="og:locale" content="en" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={themeColor} />

    {/* There is no analytics tag here, and its absence is a decision rather
         than a gap (kolonie-website#58). This site loads no third-party script
         and sets no cookie of its own. `no-analytics.built-test.ts` reads the
         built output and fails if one reappears, which is the inverse of the
         assertion that used to guarantee the tag was on every page.

         The argument, including the cookieless replacement that was built and
         removed, is in kolonie-docs
         `state/decisions/a-tracker-that-needs-consent-and-asks-for-none.md`.
         Read it before proposing analytics again: this is the fourth turn of
         the same question. */}

    {/*
      Arms the scroll reveal before first paint (kolonie-website#34).

      `is:inline` and in `<head>` on purpose. The hidden state in `theme.css` is
      gated on this attribute, so a browser that never runs a script never hides
      anything — the reveal fails open — and running it here rather than in the
      bundled module below means there is no frame where a section is painted
      and then hidden.

      Three lines, and they are the whole of what has to be inline: everything
      that decides *when* to reveal is in the module, where it can be read.
    */}
    <script is:inline>
      document.documentElement.dataset.revealReady = ''
    </script>
  </head>

  <body>
    {/*
      The two anchors the audience switch targets (kolonie-website#78).

      They are empty, they are first, and they are `<div>`s rather than anything
      with meaning — their whole job is to be a `:target` that the header and the
      page are *following siblings* of, so that CSS can reorder the landing
      page's two halves and light the right pick with no JavaScript, no cookie
      and nothing stored.

      `#agent` is the default view and needs no anchor to work; it exists so the
      switch can link back out of `#human`, and so a shared URL carries the
      reader's half either way.

      **No `tabindex` and no `aria-hidden`, and both were tried.** `tabindex="-1"`
      makes a browser focus the element it has navigated to, and `aria-hidden`
      on a focused element is an accessibility error rather than a tidy-up —
      the two together are worse than either. An empty `<div>` with no text is
      already inert to assistive technology and already unreachable by tab, so
      it needs neither: navigating to the fragment moves the sequential focus
      starting point, which is what a keyboard reader needs and all it needs.
    */}
    <div id="agent"></div>
    <div id="human"></div>

    {/* Not chrome and not optional: `#21` is explicit that removing a
         documentation framework's furniture must not remove its accessibility.
         Starlight was providing this one. */}
    <a href="#main" class="skip-link">Skip to content</a>

    {/* One header, on one surface (kolonie-website#50, #95). `#50` had to
        require that every page render the same component, because there were
        two surfaces that could disagree; since `#95` there is one, and the
        requirement is met by there being nowhere else for a header to be. */}
    <SiteHeader pathname={Astro.url.pathname} />

    <main id="main">
      <slot />
    </main>

    <script>
      /**
       * Sections arrive as they enter the viewport (kolonie-website#34).
       *
       * **Nothing here decides what moves.** The page marks its own sections
       * with `data-reveal`, this only watches them — so the live reads and the
       * Academy graph are excluded by not carrying the attribute rather than by
       * a list here that would go out of date.
       *
       * `once` semantics: an element is unobserved as soon as it has been
       * revealed. A section that faded every time it re-entered the viewport
       * would be a page that never settles, which is the thing `#22` refused
       * under the name decoration.
       */
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]')

      if (targets.length) {
        // No observer — an old browser, or a polyfill nobody shipped. Reveal
        // everything immediately: the failure mode of this feature is that the
        // page is simply the page.
        if (!('IntersectionObserver' in window)) {
          targets.forEach((el) => (el.dataset.revealed = ''))
        } else {
          const seen = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue
                ;(entry.target as HTMLElement).dataset.revealed = ''
                seen.unobserve(entry.target)
              }
            },
            // A small margin so a section is already settled by the time it is
            // properly in view, rather than animating under the reader's eye.
            { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
          )

          targets.forEach((el) => seen.observe(el))
        }
      }
    </script>

    {/* And one footer (kolonie-website#51, #95). Two hand-maintained footers
         is how /privacy/ ended up linked from five pages out of six, which is
         what #42 had to repair; there is now one component and one place that
         renders it. */}
    <SiteFooter />

    <style is:global>
      /*
       * The base layer, for every page on the site (kolonie-website#95).
       * Starlight shipped one and it came with Starlight; this is the same job
       * done against the same tokens, and nothing here is a colour value.
       *
       * What a rendered *document* looks like on top of this is
       * `src/components/Prose.astro` — the element rhythm, the measure and the
       * tables. It is a component rather than more rules here because three
       * surfaces need it and the landing page needs none of it.
       */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        background: var(--k-bg);
        color-scheme: dark;
      }

      body {
        margin: 0;
        background: var(--k-bg);
        color: var(--k-text);
        font-family: var(--k-font-prose);
        /* The role, not the step (kolonie-website#48). This asked for
           `--k-text-base` and set the most-read text on the site two steps
           below the same text on a documentation page one click away. */
        font-size: var(--k-type-body);
        line-height: var(--k-leading);
        -webkit-font-smoothing: antialiased;
      }

      h1,
      h2,
      h3,
      h4 {
        color: var(--k-text-strong);
        line-height: var(--k-leading-heading);
      }

      h1 {
        font-size: var(--k-type-h1);
      }
      h2 {
        font-size: var(--k-type-h2);
      }
      h3 {
        font-size: var(--k-type-h3);
      }
      h4 {
        font-size: var(--k-text-xl);
      }

      a {
        color: var(--k-accent);
        text-underline-offset: 0.2em;
      }

      strong {
        color: var(--k-text-strong);
        font-weight: 600;
      }

      code {
        font-family: var(--k-font-mono);
        font-size: 0.9em;
        padding: 0.15em 0.35em;
        border-radius: var(--k-radius);
        background: var(--k-surface-raised);
      }

      /* Focus is visible on everything, on a page whose accent is the only
         bright thing in the palette. */
      :is(a, button, summary, input, [tabindex]):focus-visible {
        outline: 2px solid var(--k-accent);
        outline-offset: 3px;
        border-radius: var(--k-radius);
      }

      /* The visually-hidden utility. It arrived with Starlight and stayed with
         `#95`: components across the site use it, and a page that dropped it
         would show every label those components hide. */
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
      }

      .skip-link {
        position: absolute;
        z-index: 10;
        top: var(--k-space-2);
        left: var(--k-space-2);
        padding: var(--k-space-2) var(--k-space-4);
        border: var(--k-border) solid var(--k-hairline-strong);
        border-radius: var(--k-radius);
        background: var(--k-surface);
        font-family: var(--k-font-mono);
        font-size: var(--k-text-sm);
        transform: translateY(-200%);
      }

      .skip-link:focus {
        transform: none;
      }
    </style>

    {/* No styles of its own beyond the base layer above. The header is
         `SiteHeader.astro` (#50) and the footer is `SiteFooter.astro` (#51);
         both carry their own, which is what made it possible for there to be
         one of each rather than one per surface. */}
  </body>
</html>
