---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'

import Site from '../layouts/Site.astro'
import Prose from '../components/Prose.astro'

/**
 * One legal page — `/privacy/`, `/imprint/`, `/terms/`, `/citizen-terms/`
 * (kolonie-website#42, #49).
 *
 * The text is not here and no copy of it is in this repository: it is
 * `kolonie-docs/governance/<slug>.md`, rendered by `src/lib/legal-loader.ts`.
 * That is the rule `#41` set for the entity and `#42` and `#44` both repeat —
 * a legal page hand-copied onto a website is a second copy of a fact that ages
 * without anybody noticing, and these are the pages where that costs most.
 * **`#49` changed nothing about that**: the loader is untouched and this is a
 * rendering change only.
 *
 * **It rendered through `StarlightPage` until `#49`, and that was the defect.**
 * Measured 2026-08-06 against the deployed site, `/terms/` came out near-white
 * where `/` was near-black — the two grounds are quoted on `#49`, and not here,
 * because a colour value outside `theme.css` fails `theme.test.ts` even in a
 * comment, which is the rule working. Two design systems on one domain, one
 * click apart in the footer. The cause was this file: `StarlightPage` brings
 * the framework's own theme with it.
 *
 * `#21`'s rule was *a page under `src/content/docs/docs/` is documentation and
 * gets the furniture; everything else is not and gets none of it*, and the
 * comment this replaces already said a legal page is not documentation — and
 * then called `StarlightPage` anyway. `#49` made the code agree with the
 * comment; `#95` removed the framework the other half of the rule was about, so
 * there is one layout and this page is no longer the exception to anything.
 *
 * **The heading is the document's own `#`, and this page adds none.** Rendering
 * the frontmatter title as a heading above the content is what put it on the
 * page twice. Every one of the four source files opens with its own, and
 * `legal.built-test.ts` fails if one stops doing so — a page with no heading is
 * the failure at the other end of the same fix.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const pages = await getCollection('legal')
  return pages.map((page) => ({ params: { legal: page.id }, props: { page } }))
}

const { page } = Astro.props as { page: CollectionEntry<'legal'> }
const { Content } = await render(page)
---

<Site title={page.data.title} description={page.data.description}>
  <Prose class="legal">
    <Content />

    {/*
      **The sentence that makes the arrangement checkable**, and `#49` requires
      it to survive the move: a reader who wants to know whether the page and
      the document agree is told where the document is.
    */}
    <hr />
    <p class="legal__source">
      <small>
        Rendered from <a href={page.data.source}>the Colony’s repository</a>, which is
        where this document is written and versioned. If this page and that file ever
        disagree, the file is the one that counts.
      </small>
    </p>
  </Prose>
</Site>

<style>
  /*
   * **The prose layer is `src/components/Prose.astro` since kolonie-website#95**
   * — the rhythm, the measure, the tables and the code blocks that were this
   * file's own `<style>` block from `#49`. Three surfaces render markdown now
   * and three copies of a vertical rhythm is three rhythms within a month.
   *
   * What is left here is the one rule that is about a legal page rather than
   * about prose.
   */
  .legal__source {
    color: var(--k-text-faint);
  }
</style>
