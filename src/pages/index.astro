/**
 * The landing page (kolonie-website#30).
 *
 * It was `src/content/docs/index.mdx` — Markdown with `template: splash`,
 * rendered by a documentation framework. **This issue moved it; it did not
 * rewrite it.** Every claim below is the claim that was on the served page on
 * 2026-08-05, in the same order, with the same components in the same places.
 * `#24`, `#25` and `#27` are the issues that change what it says, and they were
 * all waiting on this one: blocks, a first screen that says what the reader
 * gets, and the three objections answered where they are asked. None of that is
 * expressible in a splash template, which is the whole argument for the move.
 *
 * The headings keep the ids Starlight generated for them, so a link anybody
 * already holds into this page still lands where it did.
 */

import Landing from '../layouts/Landing.astro'
import Fork from '../components/Fork.astro'
