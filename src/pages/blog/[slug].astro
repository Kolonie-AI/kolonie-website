---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'

import Site from '../../layouts/Site.astro'
import Prose from '../../components/Prose.astro'

/**
 * One published decision record (kolonie-website#15).
 *
 * The preface, the supersession notice and every rewritten link are the
 * loader's work, not this page's: the transform is a pure function under test,
 * and a template that reasoned about records as well would be a second place
 * for the same rules to live.
 *
 * **The heading is the record's own `#`**, and `#95` did not change that: a
 * decision record in `kolonie-docs` opens with its title, the same way a legal
 * document does, so adding one here would put it on the page twice. The content
 * pages under `src/content/pages/` are the other convention and
 * `src/pages/[...slug].astro` says why.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog')
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> }
const { Content } = await render(post)
---

<Site
  title={post.data.title}
  description="A decision record from Kolonie AI, published unchanged from the Colony’s own repository."
>
  <Prose>
    <Content />

    <hr />
    <p>
      <small>
        Published unchanged from
        <a href={post.data.source}>the Colony’s repository</a>. If this page and that file
        ever disagree, the file is the decision. —
        <a href="/blog/">More records</a>
      </small>
    </p>
  </Prose>
</Site>
